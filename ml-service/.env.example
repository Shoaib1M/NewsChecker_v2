# Copy to ml-service/.env and fill in. .env is gitignored; never commit it.

# ── Search providers (all optional) ─────────────────────────────────
# Keyless providers are on by default; set a flag to false to switch one off.
GOOGLE_NEWS_ENABLED=true
WIKIPEDIA_ENABLED=true
DUCKDUCKGO_ENABLED=true
# Keyed providers join in only when their key is set.
GNEWS_API_KEY=
GUARDIAN_API_KEY=
NEWSAPI_KEY=

# ── NLI (decides every verdict) ─────────────────────────────────────
NLI_ENABLED=true
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_PRELOAD=true
EVIDENCE_BUDGET_SECONDS=45

# ── Hybrid passage retrieval ────────────────────────────────────────
SEMANTIC_PASSAGES=true
PASSAGE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_MIN_SIMILARITY=0.30

# ── NLI-checked explanations (Gemini, free tier) ────────────────────
# Free key: https://aistudio.google.com -> Get API key
EXPLANATIONS_ENABLED=true
GOOGLE_API_KEY=your-gemini-api-key-here
EXPLAIN_MODEL=gemini-3.8-flash
# Tried in order only if the model before fails (e.g. 503 high demand).
# Leave empty to use EXPLAIN_MODEL only.
EXPLAIN_FALLBACK_MODELS=gemini-3.5-flash-lite
EXPLAIN_TIMEOUT_SECONDS=10
